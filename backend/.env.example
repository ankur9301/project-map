# =============================================================================
# project_map backend :: example environment
# Copy to backend/.env and fill in the real values.
# =============================================================================

# --- Database --------------------------------------------------------------
# v2 is Postgres-only. Use your Supabase connection-pooler URL:
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Routing ---------------------------------------------------------------
ROUTING_PROVIDER=google
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
# Required Google APIs on this key:
#   Routes API
#   Places API (New)
#   Geocoding API

# --- Optional local OTP (legacy fallback) ----------------------------------
OTP_BASE_URL=http://localhost:8080/otp
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=apartment-commute-tracker/1.0 you@example.com

# --- Supabase (auth verification only — backend talks to Postgres directly) -
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Places API tuning -----------------------------------------------------
PLACES_SEARCH_RADIUS_M=1200
PLACES_CACHE_TTL_DAYS=30

# --- Overall-score weights (optional override) -----------------------------
# WEIGHT_COMMUTE=0.30
# WEIGHT_WALKABILITY=0.18
# WEIGHT_GROCERY=0.14
# WEIGHT_GYM=0.10
# WEIGHT_LIFESTYLE=0.14
# WEIGHT_FRICTION=0.14
