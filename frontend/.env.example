# =========================================================================
# project_map frontend :: example environment
# Copy to frontend/.env.local for local dev. For the deployed GH Pages build,
# set these as repository secrets (Settings -> Secrets and variables -> Actions)
# and the deploy.yml workflow injects them at build time.
# =========================================================================

# Anon key is safe to ship to the browser (RLS does the real protection).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Where the deployed backend lives. Override for prod (e.g. https://api.example.com).
VITE_API_BASE_URL=http://localhost:8000
