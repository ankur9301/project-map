{
  "manifest_version": 3,
  "name": "Apartment Commute Capture",
  "version": "1.0.0",
  "description": "Safely capture the current apartment listing into your local commute tracker.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "action": {
    "default_title": "Save apartment listing",
    "default_popup": "popup.html"
  }
}
